# 复制为 .env 后填写，不要提交 .env
# 本地开发照抄下面这段；线上把 DJANGO_DEBUG / ALLOWED_HOSTS / CSRF 三项改成注释里写的线上版本

# ---- 密钥与数据库 ----
DJANGO_SECRET_KEY=换成你自己的随机串
MYSQL_PASSWORD=你的 MySQL 密码

# ---- 运行模式 ----
# 本地开发：True（否则 runserver 不托管 media，出错也看不到堆栈）
# 线上：       False
DJANGO_DEBUG=True

# 允许访问的 Host，逗号分隔
# 本地：       localhost,127.0.0.1,[::1],testserver
# 线上：       你的域名,你的服务器IP
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],testserver

# Django 后台登录表单的可信来源，要带 http:// 或 https://，逗号分隔
# 本地留空即可；线上写：DJANGO_CSRF_TRUSTED_ORIGINS=http://hesitage.bhbigdata.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# ---- 跨域 ----
# 本地留空 → DEBUG=True 时自动放开全部来源
# 线上留空 → 只认 settings.py 里那份白名单；要加来源就在这里逗号分隔写全
CORS_ALLOWED_ORIGINS=

# ---- AI 对话 ----
SILICONFLOW_API_KEY=你的 SiliconFlow API Key
SILICONFLOW_API_BASE_URL=https://api.siliconflow.cn/v1
